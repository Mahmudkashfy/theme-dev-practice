<section class="custom-wave-banner {{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  
  <!-- WAVES SVG -->
  <svg class="waves-animated-{{ section.id }}" xmlns="http://www.w3.org/2000/svg"
       viewBox="0 24 150 28" preserveAspectRatio="none" aria-hidden="true">

    <defs>
      <path id="gentle-wave-{{ section.id }}"
        d="M-160 44c30 0
        58-18 88-18s
        58 18 88 18
        58-18 88-18
        58 18 88 18
        v44h-352z" />
    </defs>

    <g class="wave-parallax1-{{ section.id }}">
      <use href="#gentle-wave-{{ section.id }}" x="50" y="3" fill="currentColor" />
    </g>
    <g class="wave-parallax2-{{ section.id }}">
      <use href="#gentle-wave-{{ section.id }}" x="50" y="0" fill="currentColor" />
    </g>
    <g class="wave-parallax3-{{ section.id }}">
      <use href="#gentle-wave-{{ section.id }}" x="50" y="9" fill="currentColor" />
    </g>
    <g class="wave-parallax4-{{ section.id }}">
      <use href="#gentle-wave-{{ section.id }}" x="50" y="6" fill="currentColor" />
    </g>

  </svg>

  <!-- CONTENT -->
  <div class="page-width banner-content">
    <h1 class="banner-title">{{ section.settings.title }}</h1>
  </div>

</section>

{% style %}

/* ===============================
   SECTION BASE
================================= */
.{{ section.id }} {
  position: relative;
  overflow: hidden;
  padding: 80px 0 140px;
}

/* ===============================
   WAVES SVG
================================= */
.waves-animated-{{ section.id }} {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 15vh;
  min-height: 100px;
  max-height: 150px;
  color: inherit;
}

/* ===============================
   WAVE ANIMATIONS
================================= */
.wave-parallax1-{{ section.id }} {
  animation: wave-move 7s cubic-bezier(0.36, 0.45, 0.63, 0.53) infinite;
  opacity: 1;
}

.wave-parallax2-{{ section.id }} {
  animation: wave-move 10s cubic-bezier(0.36, 0.45, 0.63, 0.53) infinite;
  opacity: 0.5;
  animation-delay: -2s;
}

.wave-parallax3-{{ section.id }} {
  animation: wave-move 13s cubic-bezier(0.36, 0.45, 0.63, 0.53) infinite;
  opacity: 0.3;
  animation-delay: -4s;
}

.wave-parallax4-{{ section.id }} {
  animation: wave-move 20s cubic-bezier(0.36, 0.45, 0.63, 0.53) infinite;
  opacity: 0.15;
  animation-delay: -1s;
}
/* FORCE BOTTOM WAVE BLACK */
.waves-animated-{{ section.id }} {
  color: #000;
}


/* ===============================
   KEYFRAMES
================================= */
@keyframes wave-move {
  0% {
    transform: translate3d(-90px, 0, 0);
  }
  100% {
    transform: translate3d(85px, 0, 0);
  }
}

/* ===============================
   CONTENT
================================= */
.banner-content {
  position: relative;
  z-index: 2;
  text-align: center;
}

.banner-title {
  margin: 0;
}

/* ===============================
   RESPONSIVE
================================= */
@media (max-width: 768px) {
  .{{ section.id }} {
    padding: 60px 0 100px;
  }

  .waves-animated-{{ section.id }} {
    height: 10vh;
    min-height: 70px;
  }
}

{% endstyle %}

{% schema %}
{
  "name": "Custom Wave Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "This is Section Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Custom Wave Banner"
    }
  ]
}
{% endschema %}
